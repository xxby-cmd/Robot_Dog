<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Idealized RGB-D simulation; not a calibrated RealSense hardware emulator. -->
  <xacro:macro name="d455_camera">
    <link name="d455_camera_link">
            <!-- Onboard measurement frame; no additional payload mass or collision. -->
      <visual><geometry><box size="0.025 0.124 0.029"/></geometry><material name="black"/></visual>
    </link>
    <joint name="d455_camera_joint" type="fixed">
      <parent link="trunk"/><child link="d455_camera_link"/>
      <origin xyz="0.28 0 0.062" rpy="0 0 0"/>
    </joint>
    <link name="d455_camera_optical_frame"/>
    <joint name="d455_camera_optical_joint" type="fixed">
      <parent link="d455_camera_link"/><child link="d455_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>
    <gazebo reference="d455_camera_link">
      <sensor name="d455_rgbd_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.489</horizontal_fov>
          <image><width>$(arg camera_width)</width><height>$(arg camera_height)</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
        <always_on>true</always_on><update_rate>$(arg camera_rate)</update_rate>
        <visualize>false</visualize><topic>d455</topic>
        <gz_frame_id>d455_camera_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
